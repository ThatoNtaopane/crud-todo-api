# Supabase Auth Configuration
# Retrieve these values from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon key)
# NOTE: Never use the service_role key in the application!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Server Port (Default: 8000 for FastAPI)
PORT=8000

# Testing flag (Set to true for offline mock auth mode)
MOCK_AUTH=false

# Privileged administrator emails (for 403 Forbidden demonstration)
ADMIN_EMAILS=admin@example.com,thatontaopane@gmail.com
